# Optional. FINN runs fully without these, answering with direct quotes from documents.
# Set all three to let a model phrase answers from retrieved passages. Any OpenAI-compatible endpoint works.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Optional second model, tried once on a rate limit or outage: LLM_FALLBACK_MODEL=
# Optional caps: LLM_DAILY_LIMIT=300 (per server instance), LLM_TIMEOUT_MS=15000

# Daily monitoring. CRON_SECRET: random, 16+ characters; Vercel sends it to the cron route. Without it the route refuses everything.
# The monitoring store is a private Vercel Blob store connected to the project.
CRON_SECRET=

# Optional phone notifications. Without both VAPID keys the switch on the Alerts page says they are unavailable.
# Generate a pair with: npx web-push generate-vapid-keys. Only the public key is ever sent to browsers.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services; defaults to the production URL.
VAPID_SUBJECT=
# Random, 16+ characters. Required for the admin-only test send (POST /api/push/test); without it that route refuses everything.
PUSH_ADMIN_SECRET=
