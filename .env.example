# Optional. FINN runs fully without these, answering with direct quotes from documents.
# Set all three to let a model phrase answers from retrieved passages. Any OpenAI-compatible endpoint works.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Optional second model, tried once on a rate limit or outage: LLM_FALLBACK_MODEL=
# Optional caps: LLM_DAILY_LIMIT=300 (per server instance), LLM_TIMEOUT_MS=15000
